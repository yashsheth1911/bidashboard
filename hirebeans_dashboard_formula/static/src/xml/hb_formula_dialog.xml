<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
  Safe template extension: only position="before" is used.
  Visual domain builder per formula variable matches the original KPI tile builder.
-->
<t t-inherit="hirebeans_dashboard_suite.ItemDialog" t-inherit-mode="extension">

  <xpath expr="//div[normalize-space(.)='Data Source']" position="before">
    <t t-if="state.itemForm.item_type === 'formula'">

      <!-- Section heading -->
      <div style="font-weight:700;font-size:12px;color:var(--hb-text-muted);
                  text-transform:uppercase;letter-spacing:.5px;
                  margin-bottom:8px;margin-top:16px">
        Formula Variables
      </div>
      <div style="font-size:11px;color:var(--hb-text-muted);margin-bottom:14px">
        Define up to 4 variables (A to D). Each runs its own Odoo query.
        Combine them in the Formula Expression below.
      </div>

      <!-- Variable rows -->
      <t t-foreach="formulaState.vars" t-as="fv" t-key="fv_index">
        <div style="border:1px solid var(--hb-border);border-radius:var(--hb-radius-sm);
                    padding:12px;margin-bottom:10px;background:var(--hb-bg)">

          <!-- Letter badge + description + remove -->
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
            <span style="font-weight:700;font-size:13px;color:var(--hb-primary);
                         background:var(--hb-badge-bg);width:28px;height:28px;
                         border-radius:50%;display:flex;align-items:center;
                         justify-content:center;flex-shrink:0">
              <t t-esc="fv.var"/>
            </span>
            <input type="text" style="flex:1"
                   placeholder="Description (e.g. Total Leads)"
                   t-att-value="fv.label"
                   t-on-input="(ev) => this.onFormulaVarChange(fv_index, 'label', ev)"/>
            <button t-if="formulaState.vars.length > 1" type="button"
                    style="padding:2px 8px;border:1px solid var(--hb-border);
                           border-radius:4px;background:transparent;
                           cursor:pointer;color:var(--hb-text-muted)"
                    t-on-click="() => this.removeFormulaVar(fv_index)">
              <i class="fa fa-times"/>
            </button>
          </div>

          <!-- Model selector with searchable dropdown -->
          <div class="hb-form-row">
            <div class="hb-form-group" style="position:relative">
              <label>Odoo Model</label>
              <input type="text"
                     placeholder="Type to search model…"
                     t-att-value="fv.modelSelOpen ? fv.modelSelQuery : fv.model_name"
                     t-on-focus="() => this.varModelFocus(fv_index)"
                     t-on-blur="() => this.varModelBlur(fv_index)"
                     t-on-input="(ev) => this.varModelSearch(fv_index, ev)"/>
              <!-- Dropdown results -->
              <t t-if="fv.modelSelOpen">
                <div style="position:absolute;z-index:1000;left:0;right:0;top:100%;
                            background:var(--hb-card-bg);border:1px solid var(--hb-border);
                            border-radius:var(--hb-radius-sm);box-shadow:0 4px 12px rgba(0,0,0,.18);
                            max-height:220px;overflow-y:auto">
                  <t t-if="state.modelsLoading">
                    <div style="padding:8px 12px;font-size:12px;color:var(--hb-text-muted)">
                      <i class="fa fa-spinner fa-spin"/> Searching…
                    </div>
                  </t>
                  <t t-elif="!state.models or !state.models.length">
                    <div style="padding:8px 12px;font-size:12px;color:var(--hb-text-muted)">
                      No models found
                    </div>
                  </t>
                  <t t-else="">
                    <t t-foreach="state.models" t-as="m" t-key="m.id">
                      <div t-att-style="fv.model_name === m.model
                                        ? 'padding:6px 12px;cursor:pointer;font-size:12px;background:var(--hb-primary-bg,#eef2ff);font-weight:600'
                                        : 'padding:6px 12px;cursor:pointer;font-size:12px'"
                           t-on-mousedown="(ev) => { ev.preventDefault(); this.varModelSelect(fv_index, m.model); }">
                        <span style="color:var(--hb-text-main)"><t t-esc="m.name"/></span>
                        <span style="color:var(--hb-text-muted);margin-left:6px;font-size:11px">
                          (<t t-esc="m.model"/>)
                        </span>
                      </div>
                    </t>
                  </t>
                </div>
              </t>
            </div>
            <div class="hb-form-group">
              <label>Aggregate</label>
              <select t-on-change="(ev) => this.onFormulaVarChange(fv_index, 'aggregate', ev)">
                <option value="count" t-att-selected="fv.aggregate === 'count'">Count</option>
                <option value="sum"   t-att-selected="fv.aggregate === 'sum'">Sum</option>
                <option value="avg"   t-att-selected="fv.aggregate === 'avg'">Average</option>
                <option value="min"   t-att-selected="fv.aggregate === 'min'">Minimum</option>
                <option value="max"   t-att-selected="fv.aggregate === 'max'">Maximum</option>
              </select>
            </div>
            <div class="hb-form-group" t-if="fv.aggregate !== 'count'">
              <label>Field (for Sum / Avg / Min / Max)</label>
              <input type="text" placeholder="e.g. expected_revenue"
                     t-att-value="fv.y_field"
                     t-on-input="(ev) => this.onFormulaVarChange(fv_index, 'y_field', ev)"/>
            </div>
            <div class="hb-form-group">
              <label>Date Field</label>
              <input type="text" placeholder="create_date"
                     t-att-value="fv.date_field"
                     t-on-input="(ev) => this.onFormulaVarChange(fv_index, 'date_field', ev)"/>
            </div>
          </div>

          <!-- Visual Domain Builder -->
          <div class="hb-form-group hb-domain-builder" style="margin-top:8px">
            <label>
              Domain Filter
              <button class="hb-db-adv-toggle" type="button"
                      t-on-click="() => this.varDbToggleAdvanced(fv_index)">
                <i t-att-class="fv.dbAdvanced ? 'fa fa-eye' : 'fa fa-code'"/>
                <t t-esc="fv.dbAdvanced ? ' Visual Builder' : ' Advanced'"/>
              </button>
            </label>

            <!-- Visual rule builder -->
            <t t-if="!fv.dbAdvanced">
              <t t-if="!fv.model_name">
                <div class="hb-db-no-model">
                  <i class="fa fa-info-circle"/> Enter an Odoo Model above to build a filter
                </div>
              </t>
              <t t-elif="!fv.dbFieldsLoaded">
                <div class="hb-db-no-model">
                  <i class="fa fa-spinner fa-spin"/> Loading fields…
                </div>
              </t>
              <t t-elif="!fv.dbFields or !fv.dbFields.length">
                <div class="hb-db-no-model">
                  <i class="fa fa-exclamation-triangle"/> Model not found or has no queryable fields
                </div>
              </t>
              <t t-else="">
                <!-- Match mode header -->
                <div class="hb-db-header">
                  Match
                  <button class="hb-db-mode-btn" type="button"
                          t-on-click="() => this.varDbToggleMode(fv_index)"
                          t-att-title="(fv.dbMatchMode or 'ALL') === 'ALL' ? 'Click to switch to ANY (OR)' : 'Click to switch to ALL (AND)'">
                    <t t-esc="fv.dbMatchMode or 'ALL'"/>
                    <i class="fa fa-exchange" style="margin-left:3px;font-size:9px;opacity:.7"/>
                  </button>
                  of the following rules:
                </div>

                <!-- Rule rows -->
                <div class="hb-db-rules">
                  <t t-if="!fv.dbRules or !fv.dbRules.length">
                    <div class="hb-db-empty">
                      <i class="fa fa-filter"/> No rules — all records are included
                    </div>
                  </t>

                  <t t-foreach="fv.dbRules or []" t-as="rule" t-key="rule_index">
                    <div class="hb-db-rule">

                      <!-- Field selector -->
                      <select class="hb-db-field"
                              t-on-change="(ev) => this.varDbOnField(fv_index, rule_index, ev)">
                        <option value="">— field —</option>
                        <t t-foreach="fv.dbFields or []" t-as="f" t-key="f.name">
                          <option t-att-value="f.name" t-att-selected="rule.field === f.name">
                            <t t-esc="f.string"/> (<t t-esc="f.name"/>)
                          </option>
                        </t>
                      </select>

                      <!-- Operator selector -->
                      <select class="hb-db-op"
                              t-on-change="(ev) => this.varDbOnOp(fv_index, rule_index, ev)">
                        <t t-foreach="this._getDomainOperators(rule.fieldType or 'char')" t-as="op" t-key="op.v">
                          <option t-att-value="op.v" t-att-selected="rule.operator === op.v">
                            <t t-esc="op.l"/>
                          </option>
                        </t>
                      </select>

                      <!-- Value: boolean -->
                      <t t-if="rule.fieldType === 'boolean'">
                        <select class="hb-db-val"
                                t-on-change="(ev) => this.varDbOnValue(fv_index, rule_index, ev)">
                          <option value="true"  t-att-selected="rule.value === 'true' or rule.value === true">True</option>
                          <option value="false" t-att-selected="rule.value === 'false' or rule.value === false">False</option>
                        </select>
                      </t>

                      <!-- Value: selection -->
                      <t t-elif="rule.fieldType === 'selection'">
                        <select class="hb-db-val"
                                t-on-change="(ev) => this.varDbOnValue(fv_index, rule_index, ev)">
                          <option value="">— select —</option>
                          <t t-foreach="rule.selectionOptions or []" t-as="opt" t-key="opt[0]">
                            <option t-att-value="opt[0]" t-att-selected="rule.value === opt[0]">
                              <t t-esc="opt[1]"/>
                            </option>
                          </t>
                        </select>
                      </t>

                      <!-- Value: date -->
                      <t t-elif="rule.fieldType === 'date'">
                        <input class="hb-db-val" type="date"
                               t-att-value="rule.value"
                               t-on-change="(ev) => this.varDbOnValue(fv_index, rule_index, ev)"/>
                      </t>

                      <!-- Value: datetime -->
                      <t t-elif="rule.fieldType === 'datetime'">
                        <input class="hb-db-val" type="datetime-local"
                               t-att-value="rule.value"
                               t-on-change="(ev) => this.varDbOnValue(fv_index, rule_index, ev)"/>
                      </t>

                      <!-- Value: number -->
                      <t t-elif="['integer','float','monetary'].includes(rule.fieldType) and !['in','not in'].includes(rule.operator)">
                        <input class="hb-db-val" type="number"
                               t-att-value="rule.value"
                               t-on-input="(ev) => this.varDbOnValue(fv_index, rule_index, ev)"/>
                      </t>

                      <!-- Value: default text (also handles in/not in) -->
                      <t t-else="">
                        <input class="hb-db-val" type="text"
                               t-att-value="rule.value"
                               t-on-input="(ev) => this.varDbOnValue(fv_index, rule_index, ev)"/>
                      </t>

                      <!-- Remove rule -->
                      <button class="hb-db-remove" type="button" title="Remove rule"
                              t-on-click="() => this.varDbRemoveRule(fv_index, rule_index)">
                        <i class="fa fa-times"/>
                      </button>

                    </div>
                  </t>
                </div><!-- /hb-db-rules -->

                <button class="hb-db-add" type="button"
                        t-on-click="() => this.varDbAddRule(fv_index)">
                  <i class="fa fa-plus"/> New Rule
                </button>
              </t>
            </t>

            <!-- Advanced / raw textarea -->
            <t t-else="">
              <textarea class="hb-db-textarea"
                        t-att-value="fv.domain"
                        placeholder='[["stage_id.name","=","Won"]]'
                        t-on-input="(ev) => this.varDbOnAdvancedInput(fv_index, ev)"/>
            </t>
          </div><!-- /hb-domain-builder -->

          <!-- Apply dashboard date filter -->
          <div style="display:flex;align-items:center;gap:8px;margin-top:8px">
            <input type="checkbox" style="width:auto"
                   t-att-checked="fv.use_date_filter"
                   t-on-change="(ev) => this.onFormulaVarChange(fv_index, 'use_date_filter', ev)"/>
            <span style="font-size:12px;color:var(--hb-text-muted)">
              Apply dashboard date filter to this variable
            </span>
          </div>

        </div>
      </t><!-- /t-foreach vars -->

      <!-- Add variable button -->
      <button t-if="this.canAddFormulaVar()" type="button"
              style="padding:6px 14px;border:1px dashed var(--hb-primary);
                     border-radius:4px;background:transparent;cursor:pointer;
                     color:var(--hb-primary);font-size:12px;margin-bottom:18px"
              t-on-click="() => this.addFormulaVar()">
        <i class="fa fa-plus"/> Add Variable
        (<t t-esc="formulaState.vars.length"/>/<t t-esc="4"/>)
      </button>

      <!-- Formula Expression -->
      <div class="hb-form-group">
        <label>Formula Expression</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">
          <t t-foreach="formulaState.vars" t-as="fv" t-key="fv_index">
            <button type="button"
                    style="padding:3px 12px;border:1px solid var(--hb-primary);
                           border-radius:12px;background:var(--hb-badge-bg);
                           cursor:pointer;color:var(--hb-primary);
                           font-size:12px;font-weight:600"
                    t-on-click="() => this.insertFormulaVar(fv.var)">
              <t t-esc="fv.var"/>
              <t t-if="fv.label">
                <span style="font-weight:400;margin-left:4px"><t t-esc="fv.label"/></span>
              </t>
            </button>
          </t>
        </div>
        <input type="text"
               placeholder="e.g.  B / A * 100"
               t-att-value="state.itemForm.formula_expr"
               t-on-input="(ev) => this.onItemFormChange('formula_expr', ev)"
               style="font-family:monospace;font-size:14px"/>
        <span style="font-size:11px;color:var(--hb-text-muted);margin-top:5px;display:block">
          Operators: + - * / ( )
          &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;
          Division by zero returns 0
        </span>
      </div>

      <!-- KPI Display options (inline for formula items) -->
      <div style="font-weight:700;font-size:12px;color:var(--hb-text-muted);
                  text-transform:uppercase;letter-spacing:.5px;
                  margin-bottom:8px;margin-top:18px">
        KPI Display
      </div>
      <div class="hb-form-row">
        <div class="hb-form-group">
          <label>Format</label>
          <select t-on-change="(ev) => this.onItemFormChange('kpi_format', ev)">
            <option value="number"     t-att-selected="state.itemForm.kpi_format === 'number'">Number</option>
            <option value="currency"   t-att-selected="state.itemForm.kpi_format === 'currency'">Currency</option>
            <option value="percentage" t-att-selected="state.itemForm.kpi_format === 'percentage'">Percentage</option>
            <option value="duration"   t-att-selected="state.itemForm.kpi_format === 'duration'">Duration</option>
          </select>
        </div>
        <div class="hb-form-group">
          <label>Prefix</label>
          <input type="text" placeholder="e.g. $"
                 t-att-value="state.itemForm.kpi_prefix"
                 t-on-input="(ev) => this.onItemFormChange('kpi_prefix', ev)"/>
        </div>
        <div class="hb-form-group">
          <label>Suffix</label>
          <input type="text" placeholder="e.g. %"
                 t-att-value="state.itemForm.kpi_suffix"
                 t-on-input="(ev) => this.onItemFormChange('kpi_suffix', ev)"/>
        </div>
      </div>
      <div class="hb-form-group">
        <label>Card Color</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <t t-foreach="KPI_COLORS" t-as="col" t-key="col">
            <div t-att-class="'hb-chart-type-btn ' + (state.itemForm.kpi_color === col ? 'active' : '')"
                 t-on-click="() => this.selectKpiColor(col)"
                 style="min-width:64px">
              <t t-esc="col"/>
            </div>
          </t>
        </div>
      </div>
      <div class="hb-form-group">
        <label>Icon</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <t t-foreach="KPI_ICONS" t-as="icon" t-key="icon">
            <div t-att-class="'hb-chart-type-btn ' + (state.itemForm.kpi_icon === icon ? 'active' : '')"
                 t-on-click="() => this.selectKpiIcon(icon)"
                 style="min-width:42px">
              <i t-att-class="'fa ' + icon"/>
            </div>
          </t>
        </div>
      </div>

      <!-- Info banner -->
      <div style="font-size:11px;color:var(--hb-text-muted);padding:8px 12px;
                  background:var(--hb-badge-bg);border-radius:4px;
                  margin-top:4px;margin-bottom:4px;border-left:3px solid var(--hb-primary)">
        <i class="fa fa-info-circle"/> The Data Source and Chart Appearance
        sections below are not used for Formula KPI items.
      </div>

    </t><!-- /t-if formula -->
  </xpath>

</t>

</templates>
