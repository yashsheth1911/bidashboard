<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default Formula KPI tiles added to each AB Dashboards template -->

        <record id="item_formula_crm_win_rate" model="hb.dashboard.item">
            <field name="dashboard_id" ref="hirebeans_dashboard_suite.dashboard_crm_template"/>
            <field name="name">Win Rate</field>
            <field name="item_type">formula</field>
            <field name="formula_variables">[{"var": "A", "label": "Won", "model_name": "crm.lead", "domain": "[('won_status','=','won')]", "aggregate": "count", "use_date_filter": false}, {"var": "B", "label": "Won+Lost", "model_name": "crm.lead", "domain": "[('won_status','in',['won','lost'])]", "aggregate": "count", "use_date_filter": false}]</field>
            <field name="formula_expr">A/B*100</field>
            <field name="domain">[]</field>
            <field name="date_filter">all</field>
            <field name="kpi_icon">fa-trophy</field>
            <field name="kpi_color">red</field>
            <field name="kpi_format">percentage</field>
            <field name="kpi_suffix">%</field>
            <field name="x">3</field><field name="y">2</field><field name="w">3</field><field name="h">2</field>
        </record>

        <record id="item_formula_hr_hire_rate" model="hb.dashboard.item">
            <field name="dashboard_id" ref="hirebeans_dashboard_suite.dashboard_hr_template"/>
            <field name="name">Hire Conversion Rate</field>
            <field name="item_type">formula</field>
            <field name="formula_variables">[{"var": "A", "label": "Hired", "model_name": "hr.applicant", "domain": "[('date_closed','!=',False)]", "aggregate": "count", "use_date_filter": false}, {"var": "B", "label": "Total Candidates", "model_name": "hr.applicant", "domain": "[]", "aggregate": "count", "use_date_filter": false}]</field>
            <field name="formula_expr">A/B*100</field>
            <field name="domain">[]</field>
            <field name="date_filter">all</field>
            <field name="kpi_icon">fa-percent</field>
            <field name="kpi_color">red</field>
            <field name="kpi_format">percentage</field>
            <field name="kpi_suffix">%</field>
            <field name="x">3</field><field name="y">2</field><field name="w">3</field><field name="h">2</field>
        </record>

        <record id="item_formula_acc_collection_rate" model="hb.dashboard.item">
            <field name="dashboard_id" ref="hirebeans_dashboard_suite.dashboard_accounting_template"/>
            <field name="name">Collection Rate</field>
            <field name="item_type">formula</field>
            <field name="formula_variables">[{"var": "A", "label": "Paid", "model_name": "account.move", "domain": "[('move_type','=','out_invoice'),('state','=','posted'),('payment_state','=','paid')]", "aggregate": "sum", "y_field": "amount_total", "use_date_filter": false}, {"var": "B", "label": "Total Invoiced", "model_name": "account.move", "domain": "[('move_type','=','out_invoice'),('state','=','posted')]", "aggregate": "sum", "y_field": "amount_total", "use_date_filter": false}]</field>
            <field name="formula_expr">A/B*100</field>
            <field name="domain">[]</field>
            <field name="date_filter">all</field>
            <field name="kpi_icon">fa-percent</field>
            <field name="kpi_color">red</field>
            <field name="kpi_format">percentage</field>
            <field name="kpi_suffix">%</field>
            <field name="x">3</field><field name="y">2</field><field name="w">3</field><field name="h">2</field>
        </record>

        <record id="item_formula_inv_completion_rate" model="hb.dashboard.item">
            <field name="dashboard_id" ref="hirebeans_dashboard_suite.dashboard_inventory_template"/>
            <field name="name">Transfer Completion Rate</field>
            <field name="item_type">formula</field>
            <field name="formula_variables">[{"var": "A", "label": "Done", "model_name": "stock.picking", "domain": "[('state','=','done')]", "aggregate": "count", "use_date_filter": false}, {"var": "B", "label": "Total", "model_name": "stock.picking", "domain": "[('state','in',['done','assigned','confirmed'])]", "aggregate": "count", "use_date_filter": false}]</field>
            <field name="formula_expr">A/B*100</field>
            <field name="domain">[]</field>
            <field name="date_filter">all</field>
            <field name="kpi_icon">fa-percent</field>
            <field name="kpi_color">red</field>
            <field name="kpi_format">percentage</field>
            <field name="kpi_suffix">%</field>
            <field name="x">3</field><field name="y">2</field><field name="w">3</field><field name="h">2</field>
        </record>

        <record id="item_formula_sales_quote_rate" model="hb.dashboard.item">
            <field name="dashboard_id" ref="hirebeans_dashboard_suite.dashboard_sales_template"/>
            <field name="name">Quote-to-Order Rate</field>
            <field name="item_type">formula</field>
            <field name="formula_variables">[{"var": "A", "label": "Confirmed", "model_name": "sale.order", "domain": "[('state','in',['sale','done'])]", "aggregate": "count", "use_date_filter": false}, {"var": "B", "label": "All Quotes+Orders", "model_name": "sale.order", "domain": "[('state','in',['draft','sent','sale','done'])]", "aggregate": "count", "use_date_filter": false}]</field>
            <field name="formula_expr">A/B*100</field>
            <field name="domain">[]</field>
            <field name="date_filter">all</field>
            <field name="kpi_icon">fa-percent</field>
            <field name="kpi_color">red</field>
            <field name="kpi_format">percentage</field>
            <field name="kpi_suffix">%</field>
            <field name="x">3</field><field name="y">2</field><field name="w">3</field><field name="h">2</field>
        </record>

    </data>
</odoo>
