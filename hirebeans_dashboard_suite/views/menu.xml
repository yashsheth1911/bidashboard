<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client Action: Dashboard List -->
        <record id="action_hb_dashboard_list" model="ir.actions.client">
            <field name="name">Dashboards</field>
            <field name="tag">hb_dashboard_main</field>
            <field name="target">main</field>
        </record>

        <!-- Client Action: Dashboard Builder (used dynamically) -->
        <record id="action_hb_dashboard_builder" model="ir.actions.client">
            <field name="name">Dashboard Builder</field>
            <field name="tag">hb_dashboard_builder</field>
            <field name="target">main</field>
        </record>

        <!-- Main Menu -->
        <menuitem
            id="menu_hb_dashboard_root"
            name="BI Dashboard"
            web_icon="hirebeans_dashboard_suite,static/src/img/hirebeans-logo.png"
            sequence="2"
            groups="hirebeans_dashboard_suite.group_hb_dashboard_user"
        />

        <menuitem
            id="menu_hb_dashboard_main"
            name="My Dashboards"
            parent="menu_hb_dashboard_root"
            action="action_hb_dashboard_list"
            sequence="1"
            groups="hirebeans_dashboard_suite.group_hb_dashboard_user"
        />

        <!-- Backend list/form for managers -->
        <record id="action_hb_dashboard_backend" model="ir.actions.act_window">
            <field name="name">All Dashboards</field>
            <field name="res_model">hb.dashboard</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <menuitem
            id="menu_hb_dashboard_manage"
            name="Manage"
            parent="menu_hb_dashboard_root"
            sequence="10"
            groups="hirebeans_dashboard_suite.group_hb_dashboard_manager"
        />

        <menuitem
            id="menu_hb_dashboard_all"
            name="All Dashboards"
            parent="menu_hb_dashboard_manage"
            action="action_hb_dashboard_backend"
            sequence="1"
            groups="hirebeans_dashboard_suite.group_hb_dashboard_manager"
        />

        <!-- Configuration -->
        <menuitem
            id="menu_hb_dashboard_config"
            name="Configuration"
            parent="menu_hb_dashboard_root"
            sequence="20"
            groups="hirebeans_dashboard_suite.group_hb_dashboard_manager"
        />

        <record id="action_hb_res_config_settings" model="ir.actions.act_window">
            <field name="name">Dashboard Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module' : 'hirebeans_dashboard_suite'}</field>
            <field name="target">current</field>
        </record>

        <menuitem
            id="menu_hb_dashboard_settings"
            name="Settings"
            parent="menu_hb_dashboard_config"
            action="action_hb_res_config_settings"
            sequence="1"
            groups="hirebeans_dashboard_suite.group_hb_dashboard_manager"
        />
    </data>
</odoo>
