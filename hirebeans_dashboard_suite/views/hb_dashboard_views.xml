<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Dashboard List View (backend manager) -->
        <record id="view_hb_dashboard_list" model="ir.ui.view">
            <field name="name">hb.dashboard.list</field>
            <field name="model">hb.dashboard</field>
            <field name="arch" type="xml">
                <list string="Dashboards" decoration-muted="not active">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="industry_tag"/>
                    <field name="theme"/>
                    <field name="item_count"/>
                    <field name="is_public"/>
                    <field name="is_template"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" column_invisible="True"/>
                    <button name="action_open_dashboard" type="object" string="Open" icon="fa-external-link" class="btn-sm btn-primary"/>
                </list>
            </field>
        </record>

        <!-- Dashboard Form View -->
        <record id="view_hb_dashboard_form" model="ir.ui.view">
            <field name="name">hb.dashboard.form</field>
            <field name="model">hb.dashboard</field>
            <field name="arch" type="xml">
                <form string="Dashboard">
                    <header>
                        <button name="action_open_dashboard" type="object" string="Open Dashboard" class="btn-primary" icon="fa-tachometer"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Dashboard Name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="industry_tag"/>
                                <field name="is_template"/>
                            </group>
                            <group>
                                <field name="theme"/>
                                <field name="primary_color" widget="color"/>
                                <field name="background_color" widget="color"/>
                                <field name="is_public"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Items" name="items">
                                <field name="dashboard_item_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="item_type"/>
                                        <field name="model_id"/>
                                        <field name="aggregate"/>
                                        <field name="date_filter"/>
                                        <field name="x"/>
                                        <field name="y"/>
                                        <field name="w"/>
                                        <field name="h"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Access Control" name="access">
                                <group>
                                    <field name="shared_user_ids" widget="many2many_tags"/>
                                    <field name="group_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                            <page string="Settings" name="settings">
                                <group>
                                    <field name="default_date_filter"/>
                                    <field name="auto_refresh"/>
                                    <field name="refresh_interval" invisible="not auto_refresh"/>
                                    <field name="grid_columns"/>
                                    <field name="cell_height"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Dashboard Search View -->
        <record id="view_hb_dashboard_search" model="ir.ui.view">
            <field name="name">hb.dashboard.search</field>
            <field name="model">hb.dashboard</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="industry_tag"/>
                    <filter string="My Dashboards" name="my_dashboards" domain="[('user_id', '=', uid)]"/>
                    <filter string="Public" name="public" domain="[('is_public', '=', True)]"/>
                    <filter string="Templates" name="templates" domain="[('is_template', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Bookmarked" name="bookmarked" domain="[('bookmark_user_ids', 'in', [uid])]"/>
                    <group>
                        <filter string="Owner" name="group_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Industry" name="group_industry" context="{'group_by': 'industry_tag'}"/>
                        <filter string="Theme" name="group_theme" context="{'group_by': 'theme'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Dashboard Item Form (standalone editing) -->
        <record id="view_hb_dashboard_item_form" model="ir.ui.view">
            <field name="name">hb.dashboard.item.form</field>
            <field name="model">hb.dashboard.item</field>
            <field name="arch" type="xml">
                <form string="Dashboard Item">
                    <sheet>
                        <group>
                            <group string="Basic">
                                <field name="dashboard_id"/>
                                <field name="name"/>
                                <field name="item_type"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Grid Position">
                                <field name="x"/>
                                <field name="y"/>
                                <field name="w"/>
                                <field name="h"/>
                            </group>
                        </group>
                        <group>
                            <group string="Data Source">
                                <field name="model_id"/>
                                <field name="x_field"/>
                                <field name="y_field"/>
                                <field name="aggregate"/>
                                <field name="domain"/>
                                <field name="date_field"/>
                                <field name="date_filter"/>
                                <field name="groupby_field"/>
                                <field name="limit"/>
                            </group>
                            <group string="Appearance">
                                <field name="chart_color" widget="color"/>
                                <field name="color_scheme"/>
                                <field name="kpi_icon"/>
                                <field name="kpi_color"/>
                                <field name="kpi_format"/>
                                <field name="show_legend"/>
                                <field name="stack_chart"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
