<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="module_category_hb_dashboard" model="ir.module.category">
            <field name="name">BI Dashboard</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilege (Odoo 19: groups are organized via privilege, not category_id) -->
        <record id="privilege_hb_dashboard" model="res.groups.privilege">
            <field name="name">BI Dashboard</field>
            <field name="category_id" ref="module_category_hb_dashboard"/>
            <field name="sequence">100</field>
        </record>

        <!-- Security Groups -->
        <record id="group_hb_dashboard_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_hb_dashboard"/>
            <field name="comment">Can view and create dashboards.</field>
        </record>

        <record id="group_hb_dashboard_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_hb_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('group_hb_dashboard_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full access to all dashboards.</field>
        </record>

        <!-- Record Rules -->
        <record id="rule_hb_dashboard_own" model="ir.rule">
            <field name="name">BI Dashboard: Own Dashboards</field>
            <field name="model_id" ref="model_hb_dashboard"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('user_id', '=', user.id),
                ('is_public', '=', True),
                ('shared_user_ids', 'in', [user.id]),
                ('group_ids', 'in', user.all_group_ids.ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_hb_dashboard_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hb_dashboard_manager_all" model="ir.rule">
            <field name="name">BI Dashboard Manager: All Dashboards</field>
            <field name="model_id" ref="model_hb_dashboard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hb_dashboard_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
