<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- ─── Dashboard Builder / Viewer ───────────────────────────────────────── -->
<t t-name="hirebeans_dashboard_suite.DashboardBuilder">
  <div class="hb-dashboard-root" t-att-class="{'hb-dark': state.dashboard and state.dashboard.theme === 'dark'}">

    <!-- Loading -->
    <t t-if="state.loading">
      <div class="hb-page-loading">
        <div class="hb-spinner-lg"/>
        <span>Loading dashboard…</span>
      </div>
    </t>

    <t t-elif="state.dashboard">

      <!-- ── Toolbar ────────────────────────────────────────────────────── -->
      <div class="hb-builder-toolbar">
        <div class="hb-toolbar-left">
          <!-- Back -->
          <button class="hb-btn hb-btn-icon" title="Back to dashboards" t-on-click="goHome">
            <i class="fa fa-arrow-left"/>
          </button>

          <!-- Title -->
          <span class="hb-dashboard-title" t-esc="state.dashboard.name"/>

          <!-- Date filter -->
          <div class="hb-date-filter">
            <i class="fa fa-calendar-o" style="color:var(--hb-text-muted)"/>
            <select t-on-change="onDateFilterChange">
              <t t-foreach="dateFilterOptions" t-as="opt" t-key="opt.value">
                <option t-att-value="opt.value" t-att-selected="state.filters.date_filter === opt.value">
                  <t t-esc="opt.label"/>
                </option>
              </t>
            </select>
            <t t-if="isCustomDateFilter()">
              <input type="date" t-att-value="state.filters.date_from" t-on-change="onDateFromChange" title="From"/>
              <span style="color:var(--hb-text-muted)">—</span>
              <input type="date" t-att-value="state.filters.date_to" t-on-change="onDateToChange" title="To"/>
            </t>
          </div>

          <!-- Refresh -->
          <button class="hb-btn hb-btn-icon" title="Refresh all charts" t-on-click="() => this._refreshAllCharts()">
            <i class="fa fa-refresh"/>
          </button>
        </div>

        <div class="hb-toolbar-right">
          <!-- Bookmark -->
          <button class="hb-btn hb-btn-icon" t-att-class="{'active': state.dashboard.is_bookmarked}" title="Bookmark"
                  t-on-click="toggleBookmark">
            <i t-att-class="state.dashboard.is_bookmarked ? 'fa fa-bookmark' : 'fa fa-bookmark-o'"/>
          </button>

          <!-- Theme toggle -->
          <button class="hb-btn hb-btn-icon" t-on-click="toggleTheme" title="Toggle theme">
            <i t-att-class="state.dashboard.theme === 'dark' ? 'fa fa-sun-o' : 'fa fa-moon-o'"/>
          </button>

          <!-- AI -->
          <button class="hb-btn hb-btn-icon" t-att-class="{'active': state.aiPanelOpen}"
                  title="AI Assistant" t-on-click="toggleAiPanel">
            <i class="fa fa-magic"/>
          </button>

          <!-- Export -->
          <div style="position:relative">
            <button class="hb-btn hb-btn-outline" t-on-click="toggleExportMenu">
              <i class="fa fa-download"/> Export <i class="fa fa-caret-down"/>
            </button>
            <t t-if="state.showExportMenu">
              <div style="position:absolute;top:38px;right:0;background:var(--hb-card-bg);border:1px solid var(--hb-border);border-radius:var(--hb-radius-sm);box-shadow:var(--hb-card-shadow);z-index:200;min-width:160px;padding:6px 0;">
                <div class="hb-export-item" t-on-click="exportDashboardPNG"
                     style="padding:8px 14px;cursor:pointer;font-size:13px;display:flex;gap:8px;align-items:center;">
                  <i class="fa fa-image"/> Dashboard PNG
                </div>
                <div class="hb-export-item" t-on-click="exportDashboardPDF"
                     style="padding:8px 14px;cursor:pointer;font-size:13px;display:flex;gap:8px;align-items:center;">
                  <i class="fa fa-file-pdf-o"/> Dashboard PDF
                </div>
                <hr style="margin:4px 0;border:none;border-top:1px solid var(--hb-border)"/>
                <div class="hb-export-item" t-on-click="exportJSON"
                     style="padding:8px 14px;cursor:pointer;font-size:13px;display:flex;gap:8px;align-items:center;">
                  <i class="fa fa-code"/> Export JSON
                </div>
              </div>
            </t>
          </div>

          <!-- Settings -->
          <button class="hb-btn hb-btn-icon" title="Dashboard settings" t-on-click="showDashboardSettings">
            <i class="fa fa-cog"/>
          </button>

          <!-- Edit Mode Toggle -->
          <button class="hb-btn" t-att-class="state.editMode ? 'hb-btn-primary' : 'hb-btn-outline'"
                  t-on-click="toggleEditMode">
            <i t-att-class="state.editMode ? 'fa fa-check' : 'fa fa-pencil'"/>
            <t t-esc="state.editMode ? 'Done' : 'Edit'"/>
          </button>

          <!-- Add Item (edit mode only) -->
          <t t-if="state.editMode">
            <button class="hb-btn hb-btn-primary" t-on-click="showAddItem">
              <i class="fa fa-plus"/> Add Item
            </button>
          </t>
        </div>
      </div>

      <!-- ── Filter Bar ────────────────────────────────────────────────── -->
      <t t-if="state.configEnableFilterbar">
        <div class="hb-filter-bar" style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:8px 16px;border-bottom:1px solid var(--hb-border);">
          <i class="fa fa-filter" style="color:var(--hb-text-muted);font-size:12px"/>

          <t t-foreach="state.filterChips" t-as="chip" t-key="chip.id">
            <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:var(--hb-badge-bg);border:1px solid var(--hb-border);font-size:12px;">
              <i t-if="chip.source === 'click'" class="fa fa-hand-pointer-o" style="color:var(--hb-primary)" title="From chart click"/>
              <span>
                <t t-esc="chip.modelLabel"/>: <t t-esc="chip.fieldLabel"/> <t t-esc="chip.operator"/> <t t-esc="chip.valueLabel"/>
              </span>
              <i class="fa fa-times" style="cursor:pointer;opacity:.6" t-on-click="() => this.removeFilterChip(chip.id)"/>
            </span>
          </t>

          <div style="position:relative">
            <button class="hb-btn hb-btn-outline" style="padding:4px 10px;font-size:12px" t-on-click="openFilterPopover">
              <i class="fa fa-plus"/> Add Filter
            </button>

            <t t-if="state.filterPopover.open">
              <div style="position:absolute;z-index:300;top:32px;left:0;width:300px;background:var(--hb-card-bg);border:1px solid var(--hb-border);border-radius:var(--hb-radius-sm);box-shadow:var(--hb-card-shadow);padding:12px;">

                <div style="font-size:11px;font-weight:700;color:var(--hb-text-muted);text-transform:uppercase;margin-bottom:8px;">New Filter</div>

                <!-- Model picker -->
                <div style="position:relative;margin-bottom:8px">
                  <input type="text" placeholder="Type to search model…"
                         t-att-value="state.filterPopover.modelSelOpen ? state.filterPopover.modelSelQuery : state.filterPopover.modelLabel"
                         t-on-focus="filterPopoverModelFocus"
                         t-on-blur="filterPopoverModelBlur"
                         t-on-input="filterPopoverModelSearch"/>
                  <t t-if="state.filterPopover.modelSelOpen">
                    <div style="position:absolute;z-index:310;left:0;right:0;top:100%;background:var(--hb-card-bg);border:1px solid var(--hb-border);border-radius:var(--hb-radius-sm);box-shadow:0 4px 12px rgba(0,0,0,.18);max-height:180px;overflow-y:auto">
                      <t t-if="state.modelsLoading">
                        <div style="padding:8px 12px;font-size:12px;color:var(--hb-text-muted)"><i class="fa fa-spinner fa-spin"/> Searching…</div>
                      </t>
                      <t t-elif="!state.models or !state.models.length">
                        <div style="padding:8px 12px;font-size:12px;color:var(--hb-text-muted)">No models found</div>
                      </t>
                      <t t-else="">
                        <t t-foreach="state.models" t-as="m" t-key="m.id">
                          <div style="padding:6px 12px;cursor:pointer;font-size:12px"
                               t-on-mousedown="(ev) => { ev.preventDefault(); this.filterPopoverSelectModel(m.model, m.name); }">
                            <span style="color:var(--hb-text-main)"><t t-esc="m.name"/></span>
                            <span style="color:var(--hb-text-muted);margin-left:6px;font-size:11px">(<t t-esc="m.model"/>)</span>
                          </div>
                        </t>
                      </t>
                    </div>
                  </t>
                </div>

                <!-- Field + operator + value -->
                <t t-if="state.filterPopover.model">
                  <t t-if="!state.filterPopover.fieldsLoaded">
                    <div style="font-size:12px;color:var(--hb-text-muted);margin-bottom:8px"><i class="fa fa-spinner fa-spin"/> Loading fields…</div>
                  </t>
                  <t t-else="">
                    <select style="width:100%;margin-bottom:8px" t-on-change="filterPopoverOnField">
                      <option value="">— field —</option>
                      <t t-foreach="state.filterPopover.fields" t-as="f" t-key="f.name">
                        <option t-att-value="f.name" t-att-selected="state.filterPopover.field === f.name">
                          <t t-esc="f.string"/> (<t t-esc="f.name"/>)
                        </option>
                      </t>
                    </select>

                    <t t-if="state.filterPopover.field">
                      <select style="width:100%;margin-bottom:8px" t-on-change="filterPopoverOnOp">
                        <t t-foreach="this._getDomainOperators(state.filterPopover.fieldType)" t-as="op" t-key="op.v">
                          <option t-att-value="op.v" t-att-selected="state.filterPopover.operator === op.v">
                            <t t-esc="op.l"/>
                          </option>
                        </t>
                      </select>

                      <t t-if="state.filterPopover.fieldType === 'boolean'">
                        <select style="width:100%;margin-bottom:10px" t-on-change="filterPopoverOnValue">
                          <option value="true">True</option>
                          <option value="false">False</option>
                        </select>
                      </t>
                      <t t-elif="state.filterPopover.fieldType === 'selection'">
                        <select style="width:100%;margin-bottom:10px" t-on-change="filterPopoverOnValue">
                          <option value="">— select —</option>
                          <t t-foreach="state.filterPopover.selectionOptions" t-as="opt" t-key="opt[0]">
                            <option t-att-value="opt[0]"><t t-esc="opt[1]"/></option>
                          </t>
                        </select>
                      </t>
                      <t t-elif="['integer','float','monetary'].includes(state.filterPopover.fieldType)">
                        <input type="number" style="width:100%;margin-bottom:10px" t-on-input="filterPopoverOnValue"/>
                      </t>
                      <t t-elif="state.filterPopover.fieldType === 'date'">
                        <input type="date" style="width:100%;margin-bottom:10px" t-on-change="filterPopoverOnValue"/>
                      </t>
                      <t t-else="">
                        <input type="text" placeholder="Value" style="width:100%;margin-bottom:10px" t-on-input="filterPopoverOnValue"/>
                      </t>
                    </t>
                  </t>
                </t>

                <div style="display:flex;gap:8px;justify-content:flex-end">
                  <button class="hb-btn hb-btn-outline" style="font-size:12px;padding:4px 10px" t-on-click="closeFilterPopover">Cancel</button>
                  <button class="hb-btn hb-btn-primary" style="font-size:12px;padding:4px 10px" t-on-click="addFilterChip">Add</button>
                </div>
              </div>
            </t>
          </div>

          <t t-if="state.filterChips.length">
            <button class="hb-btn hb-btn-icon" style="font-size:12px" title="Clear all filters" t-on-click="clearAllFilterChips">
              <i class="fa fa-eraser"/>
            </button>
          </t>
        </div>
      </t>

      <!-- ── Grid ──────────────────────────────────────────────────────── -->
      <!-- Items are managed imperatively by GridStack JS, not OWL t-foreach -->
      <div class="hb-grid-container" t-att-class="{'hb-edit-mode': state.editMode, 'hb-view-mode': !state.editMode}">
        <div class="grid-stack" t-ref="gridContainer"/>
        <t t-if="state.items.length === 0 and state.editMode">
          <div style="padding:60px;text-align:center;color:var(--hb-text-muted);">
            <i class="fa fa-plus-circle" style="font-size:48px;opacity:0.3;display:block;margin-bottom:16px"/>
            <div style="font-size:16px;margin-bottom:8px;">Dashboard is empty</div>
            <div style="font-size:13px;margin-bottom:16px;">Click "Add Item" to add your first chart or KPI tile.</div>
          </div>
        </t>
      </div>

    </t><!-- end t-elif dashboard -->

    <!-- ── AI Panel ─────────────────────────────────────────────────────── -->
    <div class="hb-ai-panel" t-att-class="{'open': state.aiPanelOpen}">
      <div class="hb-ai-header">
        <h3><i class="fa fa-magic" style="margin-right:8px"/> AI Assistant</h3>
        <button t-on-click="closeAiPanel">×</button>
      </div>
      <div class="hb-ai-body">
        <!-- Explain result (from item click) -->
        <t t-if="state.aiExplainText">
          <div style="font-weight:600;margin-bottom:6px;font-size:13px;color:var(--hb-text)">
            Chart Explanation: <t t-esc="state.aiExplainItem and state.aiExplainItem.name"/>
          </div>
          <div class="hb-ai-response" t-esc="state.aiExplainText"/>
          <button class="hb-btn hb-btn-outline" style="margin-top:10px;width:100%"
                  t-on-click="() => { state.aiExplainText = ''; state.aiExplainItem = null; }">
            Clear
          </button>
          <hr style="border:none;border-top:1px solid var(--hb-border);margin:16px 0"/>
        </t>

        <!-- Generate new items -->
        <div style="font-weight:700;font-size:13px;color:var(--hb-text);margin-bottom:4px">Generate Items from Model</div>
        <div style="font-size:12px;color:var(--hb-text-muted);margin-bottom:12px">
          Select a model and describe what you want. AI will create dashboard items automatically.
        </div>

        <label>Odoo Model</label>
        <select t-on-change="onAiModelChange">
          <option value="">— Select Model —</option>
          <option value="sale.order">sale.order — Sales Orders</option>
          <option value="crm.lead">crm.lead — CRM Leads</option>
          <option value="account.move">account.move — Journal Entries</option>
          <option value="stock.picking">stock.picking — Stock Transfers</option>
          <option value="hr.employee">hr.employee — Employees</option>
          <option value="hr.applicant">hr.applicant — Recruitment</option>
          <option value="purchase.order">purchase.order — Purchase Orders</option>
          <option value="project.task">project.task — Project Tasks</option>
          <option value="res.partner">res.partner — Contacts</option>
          <option value="product.product">product.product — Products</option>
          <option value="helpdesk.ticket">helpdesk.ticket — Helpdesk Tickets</option>
        </select>

        <label>Intent (optional)</label>
        <textarea placeholder="e.g. Show revenue trends, top customers, and conversion rates"
                  t-on-input="onAiIntentChange"/>

        <t t-if="state.aiResponse">
          <div class="hb-ai-response" t-esc="state.aiResponse"/>
        </t>

        <t t-if="state.configAiProvider === 'disabled'">
          <div style="margin-top:12px;padding:10px;background:#fff3cd;border-radius:6px;font-size:12px;color:#856404;">
            <i class="fa fa-warning"/> AI is not configured.
            Go to <b>Configuration → Settings</b> to add an API key.
          </div>
        </t>
      </div>

      <div class="hb-ai-footer">
        <button class="hb-btn hb-btn-primary" style="flex:1"
                t-att-disabled="state.aiLoading or !state.aiModel"
                t-on-click="aiGenerate">
          <t t-if="state.aiLoading"><i class="fa fa-spinner fa-spin"/> Generating…</t>
          <t t-else=""><i class="fa fa-magic"/> Generate Items</t>
        </button>
      </div>
    </div>

    <!-- ── Dashboard Settings Modal ─────────────────────────────────────── -->
    <t t-if="state.showDashboardDialog">
      <div class="hb-modal-overlay" t-on-click.self="hideDashboardDialog">
        <div class="hb-modal">
          <div class="hb-modal-header">
            <h3><i class="fa fa-cog" style="color:#667eea;margin-right:8px"/> Dashboard Settings</h3>
            <button t-on-click="hideDashboardDialog">×</button>
          </div>
          <div class="hb-modal-body">
            <div class="hb-form-row">
              <div class="hb-form-group">
                <label>Dashboard Name</label>
                <input type="text" t-att-value="state.dashForm.name"
                       t-on-input="(ev) => this.onDashFormChange('name', ev)"/>
              </div>
              <div class="hb-form-group">
                <label>Theme</label>
                <select t-on-change="(ev) => this.onDashFormChange('theme', ev)">
                  <option value="light" t-att-selected="state.dashForm.theme === 'light'">Light</option>
                  <option value="dark"  t-att-selected="state.dashForm.theme === 'dark'">Dark</option>
                </select>
              </div>
            </div>
            <div class="hb-form-row three">
              <div class="hb-form-group">
                <label>Primary Color</label>
                <input type="color" t-att-value="state.dashForm.primary_color"
                       t-on-input="(ev) => this.onDashFormChange('primary_color', ev)"/>
              </div>
              <div class="hb-form-group">
                <label>Background Color</label>
                <input type="color" t-att-value="state.dashForm.background_color"
                       t-on-input="(ev) => this.onDashFormChange('background_color', ev)"/>
              </div>
              <div class="hb-form-group">
                <label>Card Color</label>
                <input type="color" t-att-value="state.dashForm.card_color"
                       t-on-input="(ev) => this.onDashFormChange('card_color', ev)"/>
              </div>
            </div>
            <div class="hb-form-row">
              <div class="hb-form-group">
                <label>Default Date Filter</label>
                <select t-on-change="(ev) => this.onDashFormChange('default_date_filter', ev)">
                  <t t-foreach="dateFilterOptions" t-as="opt" t-key="opt.value">
                    <option t-att-value="opt.value" t-att-selected="state.dashForm.default_date_filter === opt.value">
                      <t t-esc="opt.label"/>
                    </option>
                  </t>
                </select>
              </div>
              <div class="hb-form-group">
                <label>Icon (Font Awesome class)</label>
                <input type="text" placeholder="fa-tachometer" t-att-value="state.dashForm.icon"
                       t-on-input="(ev) => this.onDashFormChange('icon', ev)"/>
              </div>
            </div>
            <div class="hb-form-row">
              <div class="hb-form-group">
                <label>
                  <input type="checkbox" t-att-checked="state.dashForm.auto_refresh"
                         t-on-change="(ev) => this.onDashFormChange('auto_refresh', ev)"/>
                  Auto Refresh
                </label>
              </div>
              <div class="hb-form-group">
                <label>Refresh Interval (seconds)</label>
                <input type="number" min="30" max="86400" t-att-value="state.dashForm.refresh_interval"
                       t-on-input="(ev) => this.onDashFormChange('refresh_interval', ev)"/>
              </div>
            </div>
            <div class="hb-form-group">
              <label>Description</label>
              <input type="text" t-att-value="state.dashForm.description"
                     t-on-input="(ev) => this.onDashFormChange('description', ev)"/>
            </div>
            <div class="hb-form-group">
              <label>
                <input type="checkbox" t-att-checked="state.dashForm.is_public"
                       t-on-change="(ev) => this.onDashFormChange('is_public', ev)"/>
                Public (accessible by all users)
              </label>
            </div>
          </div>
          <div class="hb-modal-footer">
            <button class="hb-btn hb-btn-outline" t-on-click="hideDashboardDialog">Cancel</button>
            <button class="hb-btn hb-btn-primary" t-on-click="saveDashboard">
              <i class="fa fa-check"/> Save
            </button>
          </div>
        </div>
      </div>
    </t>

    <!-- ── Item Config Dialog ──────────────────────────────────────────── -->
    <t t-call="hirebeans_dashboard_suite.ItemDialog"/>

  </div><!-- hb-dashboard-root -->
</t>

</templates>

